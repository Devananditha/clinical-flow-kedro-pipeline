# Medallion Data Directory: Exclude all raw/processed clinical datasets, keep directory structure via .gitkeep
data/*
!data/01_raw/
!data/02_intermediate/
!data/03_primary/
!data/04_feature/

data/01_raw/*
!data/01_raw/.gitkeep

data/02_intermediate/*
!data/02_intermediate/.gitkeep

data/03_primary/*
!data/03_primary/.gitkeep

data/04_feature/*
!data/04_feature/.gitkeep
